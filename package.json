{
  "name": "paper-workbench-for-zotero",
  "type": "module",
  "version": "0.8.20.11",
  "description": "Unofficial community add-on for Zotero: a cross-platform three-column PDF workspace with selection translation, notes, and OpenAI-compatible AI chat.",
  "config": {
    "addonName": "Paper Workbench for Zotero",
    "addonID": "paper-workbench-for-zotero@tjr-ustc-hub",
    "addonRef": "zotero-ai-sidebar",
    "addonInstance": "ZoteroAISidebar",
    "prefsPrefix": "extensions.zotero-ai-sidebar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TJR-USTC-HUB/paper-workbench-for-zotero.git"
  },
  "author": "TJR-USTC-HUB contributors",
  "bugs": {
    "url": "https://github.com/TJR-USTC-HUB/paper-workbench-for-zotero/issues"
  },
  "homepage": "https://github.com/TJR-USTC-HUB/paper-workbench-for-zotero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prepare:web-agent": "npm ci --prefix web-agent --omit=dev --ignore-scripts && node scripts/patch-playwright-firefox.mjs",
    "prestart": "npm run prepare:web-agent",
    "start": "zotero-plugin serve",
    "prebuild": "npm run prepare:web-agent",
    "build": "zotero-plugin build && tsc --noEmit",
    "check:public": "prettier --check README.md README.zh-CN.md CHANGELOG.md CHANGELOG.zh-CN.md NOTICE.md package.json .github/ISSUE_TEMPLATE .github/workflows docs/USAGE.md docs/USAGE.zh-CN.md docs/RELEASE.md scripts/dev-browser-paths.mjs scripts/inspect-deepseek-dom.mjs scripts/live-test-deepseek-agent.mjs && eslint scripts/dev-browser-paths.mjs scripts/inspect-deepseek-dom.mjs scripts/live-test-deepseek-agent.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "pretest": "npm run prepare:web-agent",
    "test": "vitest run --maxWorkers=2",
    "test:zotero": "zotero-plugin test",
    "test:watch": "vitest",
    "update-deps": "npm update --save",
    "release:tag": "bash scripts/release-tag.sh",
    "release:xpi": "bash scripts/release-xpi.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@dagrejs/dagre": "^3.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "openai": "^6.35.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/dagre": "^0.7.54",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.5",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "happy-dom": "^21.0.4",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
